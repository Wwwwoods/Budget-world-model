  "lore": {
    "worldBg": "晨风边境曾是古王国北疆的驿站，十年前一场大雾吞没了北侧遗迹。如今商路仅剩南端畅通，但近几日迷雾边缘再度传出金属敲击与低语声。",
    "cgGallery": [
      { "id": "cg_dawn_plaza", "title": "晨风广场的薄雾", "caption": "朝阳照在湿润的石板路上，北方林梢隐约浮现紫色微光。", "imageUrl": "", "unlocked": true }
    ],
    "characterProfiles": [
      { "id": "npc_elder", "name": "村长艾伦", "portrait": "elder", "personality": "沉稳老练、略微保守，深藏关于古遗迹的往事。", "catchphrase": "按老规矩来说……", "backstory": "年轻时曾是北疆测绘员，亲眼见过迷雾降临之夜。" },
      { "id": "npc_merchant", "name": "游商卡琳", "portrait": "merchant", "personality": "精明爽朗、消息灵通，重利但讲信用。", "catchphrase": "这买卖你不亏！", "backstory": "常年往返南北商队，手头总有些来路神秘的小物件。" },
      { "id": "npc_ranger", "name": "守林人莱恩", "portrait": "ranger", "personality": "寡言敏锐、熟悉林间异象，对擅闯者警惕但敬重强者。", "catchphrase": "听风声，别乱踩。", "backstory": "独自在北方迷雾林缘巡逻了五年，记录着每一次钟声响起的时间。" }
    ]
  },
